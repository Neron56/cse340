<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% projects.forEach(project => { %>
        <div>
            <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
            <form action="/project/<%= project.project_id %>/remove" method="POST">
                <button type="submit">Remove <%= project.title %> from Volunteer list</button>
            </form>
        </div>
    <% }) %>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">View list of registered users</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>