<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= project[0].title %></h2>
    <h3><%= project[0].name %></h3>
    <p>Description: <%= project[0].description %></p>
        <ul>
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>"><%= category.name %></a><br>Location:  <%= project[0].location%> <br> Date: <%= project[0].date%> </li>
            <% }); %>
        </ul>
        <% if (isLoggedIn) { %>
            <form action="/project/<%= project[0].project_id %>/volunteer" method="POST">
                <button type="submit">Volunteer for the Project</button>
            </form>
            <% if (isVolunteered === true) { %>
            <form action="/project/<%= project[0].project_id %>/remove" method="POST">
                <button type="submit">Remove <%= project[0].title %> from Volunteer list</button>
            </form>
            <% } %>
        <% } %>
        <% if (user && user.role_name === 'admin') { %>
            <p><a href="/update-project/<%= project[0].project_id %>">Update the Service Project</a></p>
        <% } %>
</main>
<%- include('partials/footer') %>