<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <% categories.forEach(category => { %>
        <h2><a href="/category/<%= category.category_id %>"><%= category.name%></a></h2>
    <% }); %>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-category">New category</a></p>
    <% } %>
</main>
<%- include('partials/footer') %>