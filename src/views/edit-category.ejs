<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= categoryDetails[0].name %></h2>
 <form action="/edit-category/<%= categoryDetails[0].category_id %>" method="POST">
    <div class="form-group">
      <label for="name" >Category Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        maxlength="100"
        value="<%= categoryDetails[0].name %>"
      />
    </div>
    <button type="submit">Edit Category</button>
  </form>

</main>
<%- include('partials/footer') %>