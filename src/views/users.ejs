<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <% users.forEach(user => { %>
        <div>
            <h2><%= user.name %></h2>
            <p><%= user.email %></p>
            <p><%= user.role_name %></p>
        </div>
    <% }); %>
</main>
<%- include('partials/footer') %>